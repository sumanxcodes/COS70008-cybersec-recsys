num = (X[:, None, :] - X[None, :, :]) ** 2
den = (X[:, None, :] + X[None, :, :] + eps)
chi2_dist = 0.5 * np.sum(num / den, axis=2)            # (n,n)

# convert distance → similarity
gamma = 0.5
sim_chi = np.exp(-gamma * chi2_dist)                   # (n,n), (0,1]



