scaler = MinMaxScaler()
X_org_num = csr_matrix(scaler.fit_transform(df_orgs[num_cols]))

# ── 4) Stack into final ORG matrix ────────────────────────────────────────────
X_org_final = hstack([X_org_tokens, X_org_ohe, X_org_num], format="csr")

print("TF-IDF (org tokens):", X_org_tokens.shape)
print("One-Hot (org):      ", X_org_ohe.shape)
print("Numeric (scaled):   ", X_org_num.shape)
