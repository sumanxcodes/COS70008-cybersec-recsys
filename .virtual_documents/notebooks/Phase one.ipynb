import pandas as pd, re
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.preprocessing import OneHotEncoder, MinMaxScaler
from scipy.sparse import hstack, csr_matrix

# ── helpers ───────────────────────────────────────────────────────────────────
def split_multi_cell(x: str):
    if pd.isna(x): return []
    s = str(x).replace("|", ";").replace(",", ";")
    return [re.sub(r"\s+", "_", t.strip().lower()) for t in s.split(";") if t.strip()]

def join_prefixed_tokens(row, mapping):
    toks = []
    for col, pref in mapping:
        vals = split_multi_cell(row.get(col, ""))
        toks.extend(f"{pref}{v}" for v in vals)
    return " ".join(sorted(set(toks)))

# ── 1) TF-IDF on multi-label categorical fields ───────────────────────────────
org_cat_map = [("Threats","threat:"), ("TTPs","ttp:"), ("Aims","aim:")]
