vec_org = TfidfVectorizer(tokenizer=lambda x: x.split(), binary=False)
X_org_tokens = vec_org.fit_transform(org_text)

# ── 2) One-Hot on single-valued cats + ordinal levels ─────────────────────────
ohe_cols = ["Industry","Region","Size","SecurityBudget","PrimarySecurityTeam",
            "Maturity","Complexity"]

ohe_kwargs = dict(handle_unknown="ignore", dtype=int)
if "sparse_output" in OneHotEncoder.__init__.__code__.co_varnames:
    ohe_kwargs["sparse_output"] = True   # sklearn >= 1.2
else:
    ohe_kwargs["sparse"] = True          # sklearn < 1.2

ohe = OneHotEncoder(**ohe_kwargs)
X_org_ohe = ohe.fit_transform(df_orgs[ohe_cols])

# ── 3) MinMax on true numeric ─────────────────────────────────────────────────
