import numpy as np

def scale_sim_matrix(S, method="row_minmax", eps=1e-9, tau=0.2):
    if method == "row_minmax":                    # each org to [0,1]
        lo = S.min(axis=1, keepdims=True)
        hi = S.max(axis=1, keepdims=True)
        return (S - lo) / (hi - lo + eps)
    if method == "global_minmax":                 # whole matrix to [0,1]
        lo, hi = S.min(), S.max()
        return (S - lo) / (hi - lo + eps)
    if method == "softmax":                       # probabilistic prefs per org
        X = S / tau
        X -= X.max(axis=1, keepdims=True)
        P = np.exp(X)
        return P / (P.sum(axis=1, keepdims=True) + eps)
    if method == "row_z":                         # zero-mean/unit-std per org
        mu = S.mean(axis=1, keepdims=True)
        sd = S.std(axis=1, keepdims=True) + eps
        return (S - mu) / sd
    raise ValueError("unknown method")





