import pandas as pd
import numpy as np
import re
from collections import Counter

from sklearn.feature_extraction.text import TfidfVectorizer, CountVectorizer
from sklearn.preprocessing import MinMaxScaler, normalize
from sklearn.metrics.pairwise import cosine_similarity, chi2_kernel
from sklearn.cluster import KMeans
from scipy.sparse import hstack, csr_matrix

def split_multi_cell(x: str):
    """Split on ; , | and normalize to lowercase_with_underscores."""
    if pd.isna(x):
        return []
    s = str(x).replace("|", ";").replace(",", ";")
    out = []
    for chunk in s.split(";"):
        t = chunk.strip()
        if t:
            out.append(re.sub(r"\s+", "_", t.lower()))
    return out

def join_prefixed_tokens(row, mapping):
    """
    mapping = [(col_name, prefix), ...]
    Turn multi-valued columns into a single space-separated string with prefixes:
    e.g., 'ttp:credential_dumping group:wizard_spider soft:mimikatz ...'
    """
    toks = []
    for col, pref in mapping:
        vals = split_multi_cell(row.get(col, ""))
        toks.extend([f"{pref}{v}" for v in vals])
    return " ".join(sorted(set(toks)))  # de-dup per row, stable order




# Combine the three context columns into a raw token list
def combine_tokens_raw(row, cols=("Threats","TTPs","Aims")):
    parts = []
    for c in cols:
        if pd.notna(row.get(c, "")) and str(row.get(c, "")).strip():
            parts.append(str(row[c]))
    return ";".join(parts)

df_orgs = df_orgs.copy()
df_orgs["all_tokens_raw"] = df_orgs.apply(combine_tokens_raw, axis=1)

# Normalize to space-separated tokens for vectorization
org_text_norm = df_orgs["all_tokens_raw"].apply(
    lambda s: " ".join([re.sub(r"\s+","_",t.strip().lower())
                        for t in str(s).split(";") if t.strip()])
)

# Binary bag-of-words for clustering
vec_org = CountVectorizer(token_pattern=r"[^ ]+")
X_org = vec_org.fit_transform(org_text_norm)

# KMeans (k=4 as in your notebook; tune as needed)
kmeans = KMeans(n_clusters=4, random_state=42, n_init=10)
df_orgs["cluster"] = kmeans.fit_predict(X_org)

# Dominant tokens per cluster (for explainability and matching)
TOP_N_TOKENS = 15
org_tokens_per_row = [t.split() for t in org_text_norm]
cluster_top_tokens = {}

for c in sorted(df_orgs["cluster"].unique()):
    subset_idx = df_orgs.index[df_orgs["cluster"]==c].tolist()
    cnt = Counter()
    for idx in subset_idx:
        cnt.update(org_tokens_per_row[idx])
    cluster_top_tokens[c] = [tok for tok, _ in cnt.most_common(TOP_N_TOKENS)]

cluster_top_tokens


# Prefixed categorical tokens for exercises
ex_cat_map = [
    ("ExThreat",     "threat:"),
    ("ExTTPs",       "ttp:"),
    ("ExGroups",     "group:"),
    ("ExSoftware",   "soft:"),
    ("ExCategories", "cat:"),
    ("ExAudience",   "aud:"),
    ("ExStructure",  "struct:"),
]
ex_num_cols = ["ExMaturity","ExComplexity","ExLength","ExTradeCraftIntra","ExTradeCraftInter"]

ex_text_pref = df_exs.apply(lambda r: join_prefixed_tokens(r, ex_cat_map), axis=1)

# Unprefixed token sets for overlap/explanations (strip 'prefix:')
def unprefixed_token_set(s):
    toks = s.split()
    return set([t.split(":",1)[1] if ":" in t else t for t in toks])

ex_token_sets = ex_text_pref.apply(unprefixed_token_set)

# Categorical TF-IDF
vec_tfidf = TfidfVectorizer(token_pattern=r"[^ ]+")
X_cat = vec_tfidf.fit_transform(ex_text_pref)

# Numeric MinMax → sparse and stack
scaler = MinMaxScaler()
X_num = scaler.fit_transform(df_exs[ex_num_cols])
X_combined = hstack([X_cat, csr_matrix(X_num)])

# Pairwise similarities between exercises
sim_cosine = cosine_similarity(X_combined)          # content-based (cats+nums)
# Optional: Chi-square similarity on categorical distributions only
X_counts = CountVectorizer(token_pattern=r"[^ ]+").fit_transform(ex_text_pref)
X_dist   = normalize(X_counts, norm="l1")
sim_chi  = chi2_kernel(X_dist.toarray(), gamma=0.5)



def topk_neighbors(sim, k=5):
    n = sim.shape[0]
    neigh = {}
    for i in range(n):
        row = sim[i].copy()
        row[i] = -np.inf
        idx = np.argsort(row)[-k:][::-1]
        neigh[i] = idx
    return neigh

cosine_neighbors = topk_neighbors(sim_cosine, k=5)
chi_neighbors    = topk_neighbors(sim_chi,    k=5)

def rep_exercise_for_cluster(cluster_tokens):
    """Return index of exercise with max token-overlap vs cluster tokens."""
    best_idx, best_score = None, -1
    ctok = set(cluster_tokens)
    for idx, tokset in enumerate(ex_token_sets):
        score = len(tokset & ctok)
        if score > best_score:
            best_idx, best_score = idx, score
    return best_idx, best_score

def neighbor_table(rep_idx, neighbor_indices, cluster_tokens, sim_matrix, label):
    rows = []
    ctok = set(cluster_tokens)
    for j in neighbor_indices:
        exid     = int(df_exs.iloc[j]["EXID"])
        tokset   = ex_token_sets.iloc[j]
        overlap  = tokset & ctok
        rows.append({
            "RepIdx": rep_idx,
            "NeighborIdx": j,
            "EXID": exid,
            label: float(sim_matrix[rep_idx, j]),
            "TokenOverlapCount": len(overlap),
            "MatchedTokens": ", ".join(sorted(overlap))
        })
    return pd.DataFrame(rows).sort_values([label, "TokenOverlapCount"], ascending=False)

# Build per-cluster outputs
cluster_recs_A = {}  # c -> dict of rep + neighbor frames
for c, toks in cluster_top_tokens.items():
    rep_idx, rep_score = rep_exercise_for_cluster(toks)
    rep_exid = int(df_exs.iloc[rep_idx]["EXID"])
    cos_tbl  = neighbor_table(rep_idx, cosine_neighbors[rep_idx], toks, sim_cosine, "CosineSim")
    chi_tbl  = neighbor_table(rep_idx, chi_neighbors[rep_idx],    toks, sim_chi,    "ChiSim")
    cluster_recs_A[c] = {
        "representative_ex_idx": rep_idx,
        "representative_EXID": rep_exid,
        "rep_token_overlap_with_cluster": rep_score,
        "cosine_neighbors": cos_tbl,
        "chi_neighbors": chi_tbl,
    }

# Example: view cluster 0 recommendations
cluster_recs_A[0]["cosine_neighbors"].head()



c, toks in cluster_top_tokens.items()


